VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_ADMIN_PASSWORD=choose-a-strong-password

# Stripe Payment Links (public buy.stripe.com URLs — safe as VITE_)
VITE_STRIPE_PAYMENT_LINK_RENT=https://buy.stripe.com/test_...
VITE_STRIPE_PAYMENT_LINK_SALE=https://buy.stripe.com/test_...

# Optional (server-only; not used by Payment Links flow)
# STRIPE_SECRET_KEY=sk_test_...

# Business copy of paid-listing notices (enable matching alerts in Stripe Dashboard too)
# Buyer receipt = Stripe Customer emails → payer. Business copy = this address via Stripe notifications.
VITE_LISTING_NEEDED_NOTIFY_EMAIL=bureauficoaacredit@gmail.com

# v26 CMA tool (/api/cma) — server-only, set in Vercel → Project → Settings → Environment Variables
# Email the report to the requester + notify Marcel (https://resend.com → API Keys):
# RESEND_API_KEY=re_...
# Sender; the domain must be verified in Resend (without it only onboarding@resend.dev works, which can
# only deliver to the Resend account owner's own inbox):
# CMA_EMAIL_FROM=Marcel Najar <cma@listingneeded.com>
# Where lead notifications go (default bureauficoaacredit@gmail.com):
# CMA_NOTIFY_EMAIL=bureauficoaacredit@gmail.com
